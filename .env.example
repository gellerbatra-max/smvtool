# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml refuses to start backend/db without POSTGRES_PASSWORD,
# SMV_JWT_SECRET, and SMV_BOOTSTRAP_ADMIN_PASSWORD set -- these three must
# NOT be left on their code-level dev defaults for anything beyond a
# throwaway local trial (see backend/app/auth.py and backend/app/main.py).

POSTGRES_USER=smv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smvtool

SMV_JWT_SECRET=change-me-to-a-long-random-value
SMV_BOOTSTRAP_ADMIN_USER=admin
SMV_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Origins allowed to call the API (comma-separated). Must include wherever
# the frontend is actually served from.
SMV_CORS_ORIGINS=http://localhost:5173

# Must be reachable from the *browser*, not just from inside the compose
# network -- Vite bakes this into the frontend's static JS at build time.
VITE_API_BASE_URL=http://localhost:8000
